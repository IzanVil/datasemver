include LICENSE
include README.md
include README.pypi.md
include README.es.md
include CONTRIBUTING.md
include CHANGELOG.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include requirements.txt
include requirements-web.txt
include datasemver/py.typed
include datasemver/rules/*.yaml

recursive-include docs *.md
recursive-include examples *.yaml
recursive-include datasemver_web *.html *.css *.js *.md
recursive-include tests *.py *.csv *.json *.parquet

prune .github
prune datasets
prune scripts
exclude demo.cast

global-exclude *.py[cod]
global-exclude __pycache__
